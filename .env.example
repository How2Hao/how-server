# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=how2hao_api

# ---- 认证 ----
# JWT 密钥（沿用旧系统变量名，保证旧 accessToken 可继续验证）
AUTH_JWT_SECRET=change-me-to-a-32-char-secret
# better-auth 密钥（未设置时回退到 AUTH_JWT_SECRET）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# 短信验证码提供方：MOCK_PROVIDER | ALIYUN_DYPNS
AUTH_SMS_PROVIDER=MOCK_PROVIDER

# ---- 阿里云（短信/OSS） ----
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
OSS_BUCKET=how2hao-static
OSS_REGION=oss-cn-beijing
OSS_PUBLIC_BASE_URL=
OSS_FEEDBACK_BUCKET=how2hao-user

# ---- AI（银行卡识别/账单解析/卡面生成/优惠券 OCR） ----
DASHSCOPE_API_KEY=
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TEXT_MODEL=qwen-plus
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=glm-4.6v-flash
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-flash-latest
