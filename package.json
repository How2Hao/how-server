{
  "name": "nitro-starter",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "nitro build",
    "dev": "nitro dev",
    "preview": "nitro preview",
    "test": "vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "pnpx simple-git-hooks"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "marked": "^18.0.14",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "latest",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.9.1",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "nitro": "latest",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
